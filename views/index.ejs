<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title><%= appName %></title>

    <link
        rel="stylesheet"
        href="/css/style.css">

</head>

<body>

    <main class="container">

        <section class="card">

            <div class="logo">
                LS
            </div>

            <h1>
                <%= appName %>
            </h1>

            <p class="device">
                <%= deviceName %>
            </p>

            <div class="divider"></div>

            <div class="tap-area">

                <div class="nfc-icon">
                    NFC
                </div>

                <h2>
                    Tap Your Card
                </h2>

                <p>
                    Please tap your NFC card
                </p>

            </div>

            <div class="status">

                <span class="dot"></span>

                System Ready

            </div>

        </section>

    </main>

</body>

</html>
